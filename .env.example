# AuthZLab Environment Configuration
# Copy this file to .env and modify as needed
# NEVER commit the actual .env file to version control

# Application
APP_NAME=AuthZLab
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Database (Docker Compose internal networking)
DATABASE_URL=postgresql+psycopg://authzlab:authzlab@localhost:5432/authzlab
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Security - CHANGE IN PRODUCTION!
# Signing uses RS256 keys below (fixed algorithm); there is no shared secret.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=authzlab
JWT_AUDIENCE=authzlab-api
JWT_KID=dev-key-1
# Production MUST set persistent RSA keys (H-2). Use \n for newlines in PEM.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Development/testing fallback: ephemeral per-process keypair (sessions do not
# survive restarts and are not shared across workers).

# Password Hashing (Argon2id)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Lab Mode (Vulnerable Application)
LAB_MODE=false
LAB_ALLOW_EXTERNAL=false